// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// NEXTAUTH
// ─────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────
// USUÁRIOS (Advogados)
// ─────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  oabNumber     String?
  cpf           String?
  phone         String?
  maritalStatus String?
  profession    String?
  street        String?
  streetNumber  String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  zipCode       String?
  plan          Plan       @default(FREE)
  planStatus    PlanStatus @default(ACTIVE)

  mpCustomerId         String?   @unique
  mpSubscriptionId     String?   @unique
  mpSubscriptionStatus String?
  planExpiresAt        DateTime?

  isAdmin      Boolean   @default(false)
  firstLoginAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  clients       Client[]
  cases         Case[]
  caseNotes     CaseNote[]
  usageRecord   UsageRecord?
  payments      Payment[]
  auditLogs     AuditLog[]
  notifications Notification[]
  clientAccess  ClientAccess[]

  @@map("users")
}

enum Plan {
  FREE
  SOLO
  PRO
  PARTNER
  ADMIN
}

enum PlanStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

// ─────────────────────────────────────────
// LIMITES POR PLANO
// ─────────────────────────────────────────

model PlanLimit {
  id   String @id @default(cuid())
  plan Plan   @unique

  maxClients              Int
  maxCalculationsPerMonth Int // -1 = ilimitado
  maxOpinionsPerMonth     Int // -1 = ilimitado
  maxNotesPerCase         Int // -1 = ilimitado | FREE = 10

  simulatorEnabled   Boolean @default(false)
  retroactiveEnabled Boolean @default(false)
  exportPdfEnabled   Boolean @default(false)
  whatsappEnabled    Boolean @default(false)
  watermarkEnabled   Boolean @default(true)
  diagnosisEnabled   Boolean @default(false)
  bpcEnabled                  Boolean @default(false)
  bpcAnalysesPerMonth         Int     @default(0)
  bpcSocialMediaPerMonth      Int     @default(0)

  peticaoEnabled              Boolean @default(false)
  maxPeticoesPerMonth         Int     @default(0) // -1 = ilimitado | 0 = bloqueado

  processInterpretEnabled        Boolean @default(false)
  maxProcessInterpretPerMonth    Int     @default(0) // -1 = ilimitado | 0 = bloqueado

  revisionEnabled                Boolean @default(false)
  maxRevisionsPerMonth           Int     @default(0) // -1 = ilimitado | 0 = bloqueado
  gpsEnabled                     Boolean @default(false)
  viabilityScoreEnabled          Boolean @default(false)
  assinaturaEnabled              Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("plan_limits")
}

// ─────────────────────────────────────────
// USO ATUAL
// ─────────────────────────────────────────

model UsageRecord {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalClients          Int      @default(0)
  calculationsThisMonth Int      @default(0)
  opinionsThisMonth     Int      @default(0)
  bpcAnalysesThisMonth    Int      @default(0)
  bpcSocialMediaThisMonth Int      @default(0)
  peticoesThisMonth              Int      @default(0)
  processInterpretThisMonth      Int      @default(0)
  revisionsThisMonth             Int      @default(0)
  usageMonthRef                  DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("usage_records")
}

// ─────────────────────────────────────────
// CLIENTES (Segurados)
// ─────────────────────────────────────────

model Client {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  cpfHash       String // HMAC-SHA256 — nunca plain text
  birthDate     DateTime
  phone         String? // Formato: 5511999999999 (DDI sem +)
  email         String?
  maritalStatus String?
  profession    String?
  street        String?
  streetNumber  String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  zipCode       String?
  priority      Priority @default(NORMAL)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases Case[]

  @@index([userId])
  @@map("clients")
}

enum Priority {
  CRITICAL
  ATTENTION
  NORMAL
}

// ─────────────────────────────────────────
// CASOS
// ─────────────────────────────────────────

model Case {
  id       String @id @default(cuid())
  userId   String
  clientId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  status       CaseStatus  @default(PROSPECTING)
  priority     Priority    @default(NORMAL)
  benefitType  BenefitType
  processNumber      String?
  processLastCheck   DateTime?
  processLastMovDate DateTime?
  processLastMovCount Int?
  processLastSummary String?   @db.Text
  deadlineDays           Int?
  deadlineDate           DateTime?
  googleCalendarEventId  String?
  notes                  String?

  trackjudMonitorId     String?
  trackjudRegisteredAt  DateTime?

  // Configuração do Portal do Cliente — define quais abas o cliente pode ver
  portalConfig Json @default("{\"showProcessTracking\":true,\"showCalculations\":true,\"showRetroactives\":false,\"showInterpretation\":false}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cnisDocument CnisDocument?
  calculations Calculation[]
  retroactives Retroactive[]
  opinions     Opinion[]
  checklists   Checklist[]
  simulations  Simulation[]
  caseNotes    CaseNote[]
  bpcAnalysis  BpcAnalysis?
  clientAccess ClientAccess?
  fees         Fee[]
  revisions    Revision[]
  gpsGuides    GpsGuide[]
  assinaturas  Assinatura[]

  @@index([userId])
  @@index([clientId])
  @@index([userId, status])
  @@index([priority, deadlineDate])
  @@index([processNumber])
  @@index([trackjudMonitorId])
  @@map("cases")
}

enum CaseStatus {
  PROSPECTING
  ANALYSIS
  READY_TO_REQUEST
  PROCESSING
  FINISHED
}

enum BenefitType {
  RETIREMENT_BY_AGE
  RETIREMENT_BY_CONTRIBUTION_TIME
  SPECIAL_RETIREMENT
  HYBRID_RETIREMENT
  POINTS_RETIREMENT
  SICKNESS_BENEFIT
  ACCIDENT_BENEFIT
  MATERNITY_PAY
  PRISONER_BENEFIT
  DEATH_PENSION
  BPC_LOAS
  BENEFIT_REVIEW
}

// ─────────────────────────────────────────
// PRONTUÁRIO (CaseNote) — IMUTÁVEL
// ─────────────────────────────────────────

model CaseNote {
  id     String @id @default(cuid())
  caseId String
  userId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NoteType
  content String   @db.Text // @db.Text
  version Int // Sequencial por caso: 1, 2, 3...

  // Sem updatedAt — registro imutável por design
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([caseId, type])
  @@index([caseId, createdAt])
  @@map("case_notes")
}

enum NoteType {
  CONTACT
  DOCUMENT
  LEGAL
  INTERNAL
  CALCULATION
  PENDING_ISSUE
  BPC_ANALYSIS
}

// ─────────────────────────────────────────
// CNIS
// ─────────────────────────────────────────

model CnisDocument {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  r2Key         String
  fileName      String
  fileSizeBytes Int

  markdownContent  String           @db.Text
  extractedData    Json
  processingStatus ProcessingStatus @default(PENDING)
  processingError  String?

  nit                String?
  totalContributions Int?
  firstContribution  DateTime?
  lastContribution   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cnis_documents")
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  SUMMARY_READY
  PROCESSING_DETAILS
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────
// CÁLCULOS
// ─────────────────────────────────────────

model Calculation {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  modality   CalculationModality
  isSelected Boolean             @default(false)
  inputParams Json

  benefitSalary       Decimal  @db.Decimal(12, 2)
  rmi                 Decimal  @db.Decimal(12, 2)
  rma                 Decimal  @db.Decimal(12, 2)
  socialSecurityFactor Decimal? @db.Decimal(6, 4)
  coefficient         Decimal? @db.Decimal(6, 4)

  expectedDib      DateTime?
  gracePeriodMet   Boolean   @default(false)
  contributionTime Int?
  ageAtCalculation Int?
  eligible         Boolean   @default(false)
  pendingIssues    String[]

  calculationMemory Json
  salaryPeriods     Json

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("calculations")
}

enum CalculationModality {
  POINTS_86_96
  TOLL_50
  TOLL_100
  MINIMUM_AGE_65_62
  CONTRIBUTION_TIME
  RETIREMENT_BY_AGE
  SPECIAL_RETIREMENT
  HYBRID
  SICKNESS_BENEFIT_B31
  SICKNESS_BENEFIT_B91
  MATERNITY_PAY
  PRISONER_BENEFIT
  DEATH_PENSION
  BPC_LOAS
}

// ─────────────────────────────────────────
// RETROATIVOS
// ─────────────────────────────────────────

model Retroactive {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  entitlementStartDate DateTime
  requestDate          DateTime
  monthsLate           Int

  monthlyGrossValue   Decimal @db.Decimal(12, 2)
  totalGrossValue     Decimal @db.Decimal(12, 2)
  totalCorrectedValue Decimal @db.Decimal(12, 2)
  correctionIndex     String
  discountValue       Decimal @default(0) @db.Decimal(12, 2)
  discountDescription String?
  finalNetValue       Decimal @db.Decimal(12, 2)

  calculationMemory Json

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("retroactives")
}

// ─────────────────────────────────────────
// CHECKLIST
// ─────────────────────────────────────────

model Checklist {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  benefitType BenefitType
  items       Json
  eligible    Boolean
  pendingIssues String[]

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("checklists")
}

// ─────────────────────────────────────────
// PARECERES
// ─────────────────────────────────────────

model Opinion {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  promptUsed        String        @db.Text
  generatedContent  String        @db.Text
  customizedContent String?       @db.Text
  model             String
  tokensUsed        Int
  generationCostUsd Decimal       @db.Decimal(8, 6)
  status            OpinionStatus @default(GENERATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@map("opinions")
}

enum OpinionStatus {
  GENERATED
  REVIEWED
  FINALIZED
}

// ─────────────────────────────────────────
// SIMULAÇÕES
// ─────────────────────────────────────────

model Simulation {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  scenarioName   String
  scenarioParams Json
  rmiProjected   Decimal  @db.Decimal(12, 2)
  rmaProjected   Decimal  @db.Decimal(12, 2)
  dibProjected   DateTime
  gainVsNow      Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("simulations")
}

// ─────────────────────────────────────────
// PAGAMENTOS
// ─────────────────────────────────────────

model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mpPaymentId      String        @unique
  mpSubscriptionId String?
  plan             Plan
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("BRL")
  status           PaymentStatus
  paidAt           DateTime?
  periodStart      DateTime?
  periodEnd        DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

// ─────────────────────────────────────────
// SALÁRIO MÍNIMO HISTÓRICO
// ─────────────────────────────────────────

model MinimumWage {
  id           String   @id @default(cuid())
  effectiveDate DateTime @unique // Data de início da vigência
  value        Decimal  @db.Decimal(10, 2) // Salário mínimo
  ceiling      Decimal  @db.Decimal(10, 2) // Teto do RGPS
  legislation  String   // Ex: "Decreto 12.797/2025"
  readjustment Float?   // Percentual de reajuste (ex: 6.79)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([effectiveDate])
  @@map("minimum_wages")
}

// ─────────────────────────────────────────
// REGRAS DE APOSENTADORIA
// ─────────────────────────────────────────

model RetirementRule {
  id         String   @id @default(cuid())
  modality   String   // Ex: IDADE_MINIMA_65_62, PONTOS_86_96, PEDAGIO_50, etc.
  gender     String   // 'M', 'F' ou 'AMBOS'
  effectiveDate DateTime // Data de início da vigência desta regra

  minimumAge           Decimal? @db.Decimal(5, 1) // Ex: 62.0, 59.5
  contributionYears    Int?
  minimumPoints        Int?     // Apenas para a regra por pontos
  gracePeriodMonths    Int?

  description String   // Nome legível da regra
  legislation String   // Ex: "EC 103/2019"
  notes       String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([modality, gender, effectiveDate])
  @@index([modality, gender, effectiveDate])
  @@map("retirement_rules")
}

// ─────────────────────────────────────────
// MODALIDADES DE BENEFÍCIO / CÁLCULO
// ─────────────────────────────────────────

model ModalityLabel {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  description String?  @db.Text
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
  @@map("modality_labels")
}

enum BpcFaixaEtaria {
  MENOR_16
  MAIOR_16
}

// ─────────────────────────────────────────
// ANÁLISE BPC/LOAS
// ─────────────────────────────────────────

model BpcAnalysis {
  id               String         @id @default(cuid())
  caseId           String         @unique
  case             Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  patologia        String
  cid              String?
  idade            Int
  faixaEtaria      BpcFaixaEtaria
  rendaFamiliar    Float
  membrosGrupo     Int
  rendaPerCapita   Float
  barreiras        String?        @db.Text
  resumoLaudos     String?        @db.Text

  preAnalise       String?        @db.Text
  analiseLaudo     String?        @db.Text
  perguntasSocial  String?        @db.Text
  perguntasMedicas String?        @db.Text
  checklist        String?        @db.Text
  relatoSocial     Json?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("bpc_analyses")
}

// ─────────────────────────────────────────
// NOTIFICAÇÕES IN-APP
// ─────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  caseId    String?
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  DEADLINE_7D
  DEADLINE_3D
  DEADLINE_1D
  PLAN_LIMIT_NEAR
  CNIS_PROCESSED
  CNIS_FAILED
  PROCESS_UPDATE
  SIGNATURE_COMPLETED
}

// ─────────────────────────────────────────
// HONORÁRIOS
// ─────────────────────────────────────────

model Fee {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  description   String
  totalAmount   Decimal  @db.Decimal(12, 2)
  paidAmount    Decimal  @default(0) @db.Decimal(12, 2)
  dueDate       DateTime?
  status        FeeStatus @default(PENDING)
  notes         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@map("fees")
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

// ─────────────────────────────────────────
// AUDITORIA
// ─────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  resource  String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// ÍNDICES DE CORREÇÃO MONETÁRIA (INPC)
// ─────────────────────────────────────────

model InpcIndex {
  id         String   @id @default(cuid())
  competence String   @unique // Formato: "YYYY-MM"
  value      Decimal  @db.Decimal(10, 6) // Ex: 0.005700
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([competence])
  @@map("inpc_indices")
}

// ─────────────────────────────────────────
// REVISÃO DE BENEFÍCIOS
// ─────────────────────────────────────────

model Revision {
  id                String   @id @default(cuid())
  caseId            String
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  tipoRevisao       String   // REVISAO_VIDA_TODA | REVISAO_ART_29 | REVISAO_BURACO_NEGRO
  rmiConcedido      Decimal  @db.Decimal(10, 2)
  rmiRevisado       Decimal  @db.Decimal(10, 2)
  diferencaMensal   Decimal  @db.Decimal(10, 2)
  diferencaPercentual Float
  retroativos5Anos  Decimal  @db.Decimal(12, 2)
  elegivel          Boolean
  pendencias        String[]
  createdAt         DateTime @default(now())

  @@index([caseId])
  @@map("revisions")
}

// ─────────────────────────────────────────
// GUIAS DE CONTRIBUIÇÃO (GPS/DAS)
// ─────────────────────────────────────────

model GpsGuide {
  id                  String   @id @default(cuid())
  caseId              String
  case                Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  categoria           String   // CI, FACULTATIVO, MEI, SEGURADO_ESPECIAL
  plano               String   // NORMAL, SIMPLIFICADO, BAIXA_RENDA
  salarioContribuicao Decimal  @db.Decimal(10, 2)
  valorCalculado      Decimal  @db.Decimal(10, 2)
  aliquota            Float
  codigoPagamento     String
  competencia         String   // "YYYY-MM"
  pdfUrl              String?
  createdAt           DateTime @default(now())

  @@index([caseId])
  @@map("gps_guides")
}

// ─────────────────────────────────────────
// ASSINATURA DIGITAL (Clicksign)
// ─────────────────────────────────────────

model Assinatura {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tipoDocumento   String   // PROCURACAO, PETICAO, CONTRATO
  processoKey     String
  signUrl         String?  // Link temporário do Clicksign para assinar
  status          String   // PENDING, SIGNED, CANCELLED, EXPIRED
  documentUrl     String?
  signers         Json
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([caseId])
  @@map("assinaturas")
}

// ─────────────────────────────────────────
// PORTAL DO CLIENTE
// ─────────────────────────────────────────

model ClientAccess {
  id        String   @id @default(cuid())
  caseId    String   @unique
  userId    String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("client_access")
}

