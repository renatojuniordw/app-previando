# ─── Banco de Dados ───────────────────────────────────────────
DATABASE_URL="postgresql://previando:senha@localhost:60003/previando_db"
POSTGRES_USER=previando
POSTGRES_PASSWORD=senha
POSTGRES_DB=previando_db

# ─── NextAuth v5 ──────────────────────────────────────────────
NEXTAUTH_URL="https://app.previando.com.br"
NEXTAUTH_SECRET=""   # openssl rand -base64 32

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://default:senha@localhost:60004"
REDIS_PASSWORD=senha

# ─── Cloudflare R2 ────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="previando-docs"

# ─── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=""

# ─── Mercado Pago ─────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
MP_PLAN_ID_SOLO=""
MP_PLAN_ID_PRO=""

# ─── Admin padrão (usado no seed) ────────────────────────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# ─── Segurança ────────────────────────────────────────────────
CPF_HASH_SALT=""      # NUNCA alterar após primeiro deploy — invalida todos os CPFs
ENCRYPTION_KEY=""     # openssl rand -hex 32 (64 caracteres hex) — NUNCA alterar após criptografar dados
CRON_SECRET=""        # Token para proteger rotas de cron (/api/cron/*)
PDF_UNIFICANDO_API_KEY=""  # API key para serviço externo de PDF
RESEND_API_KEY=""          # API key do Resend (https://resend.com)
EMAIL_FROM="Previando <noreply@previando.com.br>"

# ─── CI/CD (GitHub Secrets - NUNCA hardcodar) ──────────────
# CI_DATABASE_URL=  postgresql://user:pass@localhost:5432/ci_db
# CI_REDIS_URL=     redis://localhost:6379
# E2E_DATABASE_URL= postgresql://user:pass@localhost:5432/e2e_db
# E2E_REDIS_URL=    redis://localhost:6379
# E2E_NEXTAUTH_SECRET=
# E2E_NEXTAUTH_URL= http://localhost:60002
